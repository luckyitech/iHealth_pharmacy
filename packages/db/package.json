{
  "name": "@ihealth/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma client introspected from the legacy iHealth schema, plus additive SQL.",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "build": "prisma generate",
    "test": "vitest run --passWithNoTests",
    "db:pull": "prisma db pull && node scripts/camelize-schema.js prisma/schema.prisma && prisma format",
    "db:diff": "node scripts/schema-diff.js",
    "db:report": "node scripts/unmapped-objects-report.js"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "mariadb": "3.5.4"
  }
}
