{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "resolveJsonModule": true,
    "types": ["vite/client", "@testing-library/jest-dom/vitest"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "e2e/**/*.js", "*.config.js"]
}
