{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["*.js", "packages/**/*.js", "apps/**/*.js"],
  "exclude": ["**/node_modules", "**/dist", "**/coverage"]
}
