{
  "name": "ihealth-pharmacy",
  "version": "0.0.0",
  "private": true,
  "description": "Modern rebuild of the iHealth pharmacy system (React + Node.js).",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json && tsc -p apps/web/jsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "prepare": "husky",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:copy": "scripts/db/copy-dev-db.sh",
    "db:schema:dump": "scripts/db/dump-test-schema.sh",
    "db:test:load": "scripts/db/load-test-db.sh",
    "postinstall": "npm run build -w @ihealth/db"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "glob": "14.0.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "msgpackr-extract": false,
    "cpu-features": false,
    "protobufjs": false,
    "ssh2": false,
    "fsevents@2.3.3": true
  }
}
