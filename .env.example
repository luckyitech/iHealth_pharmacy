# Copy to .env and fill in. Never commit .env.
# Each app validates its configuration at startup and refuses to boot when values are missing or invalid.

# --- General ---
NODE_ENV=development
TZ=Africa/Nairobi

# --- API (apps/api) ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Comma-separated allow-list of browser origins
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Docker dev database (a copy of the legacy schema + data; see docs/runbooks)
DATABASE_URL=mysql://ihealth:change-me@localhost:3307/ihealthpharm

# Redis (rate limiting, queues)
REDIS_URL=redis://localhost:6379

# Auth: generate each secret with `openssl rand -base64 48`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=
COOKIE_SECURE=false

# Mail (Mailpit in development)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="iHealth Pharmacy <no-reply@ihealth.local>"

# --- Web (apps/web) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- Legacy database (READ-ONLY source for scripts/db/copy-dev-db) ---
# Use a read-only MySQL account where possible.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=ihealthpharm
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
