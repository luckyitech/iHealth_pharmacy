# Copy to .env and fill in. Never commit .env.
# Each app validates its configuration at startup and refuses to boot when values are missing or invalid.

# --- General ---
NODE_ENV=development
TZ=Africa/Nairobi

# --- API (apps/api) ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Comma-separated allow-list of browser origins
CORS_ORIGINS=http://localhost:5180
LOG_LEVEL=info
# Pharmacy record shown on the sign-in page and in emails (empty = first active pharmacy)
PHARMACY_ID=
# First letters of generated document codes, e.g. employee codes DPEM0411260001
DOCUMENT_CODE_PREFIX=DP
# A bill's net is rounded to this step (1 = whole shillings, as the legacy app; 0 keeps cents)
SALES_ROUNDING_STEP=1
# Highest line discount (%) a cashier may give without a second person's approval
SALES_SELF_DISCOUNT_LIMIT=25
# Prescriber saved on bills without one (the legacy "N/A" provider); empty = none
SALES_DEFAULT_PROVIDER_ID=
# Most sales one pharmacy can keep on hold at once
SALES_MAX_HELD=30
# Minutes after a sale during which its cashier may cancel it alone
SALES_CANCEL_ALONE_MINUTES=10
# Wrong approval PINs allowed, and how long the approver is then locked out (minutes)
SALES_APPROVAL_PIN_TRIES=3
SALES_APPROVAL_LOCK_MINUTES=15
# How long an approval given at the till stays usable for that sale (minutes)
SALES_APPROVAL_VALID_MINUTES=15
# Quick reasons offered in the approval window, comma-separated
SALES_APPROVAL_REASONS=Regular customer,Price match,Near expiry,Staff purchase
# Quick reasons offered when cancelling a bill, comma-separated
SALES_CANCEL_REASONS=Wrong item,Customer changed mind,Payment failed
# Printed in quotes under the receipt's totals (empty prints nothing)
RECEIPT_RETURN_NOTE=GOODS ONCE SOLD CANNOT BE RETURNED
# Tax codes printed as "Exempt" on the receipt, comma-separated
RECEIPT_EXEMPT_TAX_CODES=E
# Cheques dated longer ago than this many months are refused
SALES_CHEQUE_MAX_AGE_MONTHS=6
# Bank notes offered as quick amounts when taking cash, smallest first
SALES_QUICK_CASH_NOTES=50,100,200,500,1000
# Most batches one till search returns
SALES_SEARCH_LIMIT=30
# Regional settings (the legacy database has none)
APP_LOCALE=en-KE
APP_CURRENCY=KES
APP_TIME_ZONE=Africa/Nairobi
# Time zone the legacy data is stored in
DB_TIME_ZONE=+03:00

# Docker dev database: a copy of the legacy schema and data (docs/runbooks/dev-database.md)
DEV_DB_PORT=3307
DEV_DB_NAME=ihealthpharm
DEV_DB_TEST_NAME=ihealthpharm_test
DEV_DB_USER=ihealth
DEV_DB_PASSWORD=change-me
DEV_DB_ROOT_PASSWORD=change-me-too
DATABASE_URL=mysql://ihealth:change-me@localhost:3307/ihealthpharm?allowPublicKeyRetrieval=true
TEST_DATABASE_URL=mysql://ihealth:change-me@localhost:3307/ihealthpharm_test?allowPublicKeyRetrieval=true

# Redis (rate limiting, queues)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Auth: generate each secret with `openssl rand -base64 48`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=
COOKIE_SECURE=false

# Public address of the web app (used in password-reset links)
APP_URL=http://localhost:5180

# Mail. In development Mailpit catches everything: open http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAILPIT_UI_PORT=8025
MAIL_FROM="iHealth Pharmacy <no-reply@ihealth.local>"

# Local admin for the Docker dev database (npm run db:dev-admin). Leave empty to generate one.
DEV_ADMIN_PASSWORD=
# Shared password for every account in the Docker dev copy (npm run db:dev-test-passwords).
DEV_TEST_PASSWORD=

# --- Web (apps/web) ---
# The web app reads its own apps/web/.env (see apps/web/.env.example); Vite must not see NODE_ENV from here.

# --- Legacy database (READ-ONLY source for scripts/db/copy-dev-db) ---
# Use a read-only MySQL account where possible. The password can also be exported in the shell instead.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=ihealthpharm
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
